{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sounio",
  "scopeName": "source.sounio",
  "fileTypes": [
    "sio"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#unit-annotation"
    },
    {
      "include": "#effect-clause"
    },
    {
      "include": "#function-def"
    },
    {
      "include": "#type-def"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.sounio",
          "begin": "//[/!]",
          "end": "$"
        },
        {
          "name": "comment.line.double-slash.sounio",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.sounio",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.sounio",
      "begin": "#!?\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "match": "\\b(IO|Mut|Panic|Div|Mod|Alloc|Epistemic|Prob|GPU|Async|Observe|Uncertainty|GUM|Neural|Witness|Net|FS|Time|Random)\\b",
          "name": "support.type.effect.sounio"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.other.attribute-name.sounio"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sounio",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sounio",
              "match": "\\\\(?:[nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "meta.interpolation.sounio",
              "match": "\\{[^}\"]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.sounio",
          "match": "'(?:\\\\(?:[nrt\\\\'\"0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sounio",
          "match": "\\b0x[0-9a-fA-F_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.binary.sounio",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.octal.sounio",
          "match": "\\b0o[0-7_]+(?:[iu](?:8|16|32|64|128|size))?\\b"
        },
        {
          "name": "constant.numeric.float.sounio",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?(?:f32|f64)?"
        },
        {
          "name": "constant.numeric.float.sounio",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+(?:f32|f64)?"
        },
        {
          "name": "constant.numeric.integer.sounio",
          "match": "\\b[0-9][0-9_]*(?:[iu](?:8|16|32|64|128|size)|f32|f64)?"
        },
        {
          "include": "#unit-annotation"
        }
      ]
    },
    "unit-annotation": {
      "name": "meta.unit-annotation.sounio",
      "begin": "(?:(?<=[0-9])\\s?|(?<=\\bf(?:32|64)))(<)(?=[A-Za-zµμ°%][A-Za-z0-9µμ°%/\\*\\^\\.\\-·\\s]*>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.unit.begin.sounio"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.unit.end.sounio"
        }
      },
      "patterns": [
        {
          "match": "[/\\*\\^·]",
          "name": "keyword.operator.unit.sounio"
        },
        {
          "match": "-?[0-9]+",
          "name": "constant.numeric.exponent.sounio"
        },
        {
          "match": "[A-Za-zµμ°%][A-Za-z0-9_]*",
          "name": "entity.name.type.unit.sounio"
        }
      ]
    },
    "effect-clause": {
      "begin": "\\b(with)\\s+(?=[A-Z])",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.effect.sounio"
        }
      },
      "end": "(?=[{;=]|$)",
      "patterns": [
        {
          "match": "\\b(IO|Mut|Panic|Div|Mod|Alloc|Epistemic|Prob|GPU|Async|Observe|Uncertainty|GUM|Neural|Witness|Net|FS|Time|Random)\\b",
          "name": "support.type.effect.sounio"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.effect.sounio"
        },
        {
          "match": ",",
          "name": "punctuation.separator.sounio"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "function-def": {
      "match": "\\b(fn|kernel)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.sounio"
        },
        "2": {
          "name": "entity.name.function.sounio"
        }
      }
    },
    "type-def": {
      "match": "\\b(struct|enum|trait|type|effect|handler|module|unit)\\s+([A-Za-z_][A-Za-z0-9_:]*)",
      "captures": {
        "1": {
          "name": "storage.type.sounio"
        },
        "2": {
          "name": "entity.name.type.sounio"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sounio",
          "match": "\\b(?:if|else|while|for|in|loop|match|return|break|continue|where|await|async|spawn|perform|handle|resume|send|recv|close|require)\\b"
        },
        {
          "name": "storage.type.sounio",
          "match": "\\b(?:fn|kernel|let|var|const|static|struct|enum|trait|impl|type|effect|handler|module|use|import|export|pub|extern|unit|crate|super|on|scope|session|chan|dual)\\b"
        },
        {
          "name": "storage.modifier.sounio",
          "match": "\\b(?:linear|affine|mut|ref|move|copy|drop|box|dyn|unsafe|as|is)\\b"
        },
        {
          "name": "keyword.other.epistemic.sounio",
          "match": "\\b(?:uncertain|belief|prior|posterior|likelihood|evidence|observe|sample|infer|confidence|entropy|audit|contest|ontology|validation|models|study|objective|strategy|policy|route|step|level|max_steps|algebra)\\b(?=\\s*[\\(\\{A-Za-z_])"
        },
        {
          "name": "storage.modifier.effect.sounio",
          "match": "\\bwith\\b"
        },
        {
          "name": "variable.language.self.sounio",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.sounio",
          "match": "\\b(?:bool|char|str|String|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|Self)\\b"
        },
        {
          "name": "support.type.epistemic.sounio",
          "match": "\\b(?:Knowledge|Uncertain|Belief|Evidence|Distribution|Quantity|Interval)\\b"
        },
        {
          "name": "support.type.sounio",
          "match": "\\b(?:Vec|Option|Result|Some|None|Ok|Err|Box|HashMap|Array|Tensor|Matrix)\\b"
        },
        {
          "name": "entity.name.type.sounio",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sounio",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.other.caps.sounio",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(!)?\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.sounio"
        },
        "2": {
          "name": "keyword.operator.macro.sounio"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sounio",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.namespace.sounio",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.sounio",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.sounio",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.sounio",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.concat.sounio",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.assignment.sounio",
          "match": "[+\\-*/%]?="
        },
        {
          "name": "keyword.operator.reference.sounio",
          "match": "&!|&"
        },
        {
          "name": "keyword.operator.arithmetic.sounio",
          "match": "[+\\-*/%^|]"
        },
        {
          "name": "keyword.operator.question.sounio",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.uncertainty.sounio",
          "match": "±"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.sounio",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.sounio",
          "match": "\\."
        }
      ]
    }
  }
}